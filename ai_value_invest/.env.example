# ===== A股棱镜 环境变量配置示例 =====
# 复制本文件为 .env 后填入真实值。
# ⚠️ .env 已被 .gitignore 忽略，不会进仓库；本示例文件是唯一对外暴露的配置说明。

# ---------- 数据库 ----------
# mysql = 生产部署；sqlite = 本地离线开发（零依赖，推荐先跑起来）
DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_DB=aistock
MYSQL_CHARSET=utf8mb4

# ---------- 会话 ----------
# 必填。生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ---------- 管理员 ----------
# 首次登录后请立即在后台「设置中心」修改
ADMIN_PASSWORD=

# ---------- AI 模型（OpenAI 兼容协议，任意服务商均可）----------
# 云端示例
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_API_KEY=
AI_MODEL_ID=

# 本地 Ollama 示例
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_API_KEY=ollama
# AI_MODEL_ID=qwen3:14b

# ---------- 数据源（全部可选，不填则相关面板显示为空）----------

# 理杏仁开放平台：K线 / 估值 / 股息 / 财务明细
LIXINGER_TOKEN=

# Tushare 兼容聚合服务：日线 / 每日指标 / 财报 / 披露计划
DATAHUB_BASE_URL=
DATAHUB_API_KEY=

# 伏尧 iFinD：龙虎榜 / 热门榜单 / 概念热度
FUYAO_TOKEN=

# Tushare Pro 官方接口
TUSHARE_TOKEN=

# AKShare 无需配置，作为免费兜底数据源
